{
  "name": "unocss-preset-completion",
  "version": "0.4.1",
  "description": "Custom auto completion preset for UnoCSS",
  "keywords": [
    "unocss",
    "unocss-preset",
    "unocss-preset-completion",
    "unpreset"
  ],
  "homepage": "https://github.com/subframe7536/unocss-preset-completion#readme",
  "bugs": {
    "url": "https://github.com/subframe7536/unocss-preset-completion/issues"
  },
  "license": "MIT",
  "author": "subframe7536",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subframe7536/unocss-preset-completion.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "release": "nub run build && nub run test && bumpp --all",
    "format": "oxfmt",
    "lint": "oxlint --fix",
    "typecheck": "tsc --noEmit",
    "qa": "oxlint --fix && oxfmt && tsc --noEmit",
    "test": "vitest --run"
  },
  "devDependencies": {
    "@subf/config": "^0.4.0",
    "@subf/oxlint-plugin": "^0.3.0",
    "@unocss/core": "^66.9.2",
    "@unocss/preset-wind3": "^66.9.2",
    "@unocss/transformer-directives": "^66.9.2",
    "@unocss/transformer-variant-group": "^66.9.2",
    "bumpp": "^11.1.0",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@unocss/core": "*"
  }
}
